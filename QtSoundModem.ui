   <widget class="QSlider" name="TXAudio">
    <property name="geometry">
     <rect>
      <x>970</x>
      <y>18</y>
      <width>90</width>
      <height>14</height>
     </rect>
    </property>
    <property name="minimum">
     <number>0</number>
    </property>
    <property name="maximum">
     <number>100</number>
    </property>
    <property name="value">
     <number>100</number>
    </property>
    <property name="orientation">
     <enum>Qt::Horizontal</enum>
    </property>
    <property name="tickPosition">
     <enum>QSlider::NoTicks</enum>
    </property>
    <property name="tickInterval">
     <number>10</number>
    </property>
    <property name="toolTip">
     <string>TX audio level (0–100%) — output volume sent to the radio's mic input.</string>
    </property>
    <property name="whatsThis">
     <string>&lt;b&gt;TX audio level&lt;/b&gt;&lt;br/&gt;Software gain applied to the modulator output before it reaches the sound card. Use this to set the audio level sent to the rig's mic/data input without touching the system audio mixer. 100% passes the modulator output unchanged; lower values attenuate. The rig's own mic-gain or data-input level still controls the resulting on-air deviation; this slider trims the QtSoundModem-side level cleanly. Default 100.&lt;br/&gt;macOS-port addition; stored as &lt;tt&gt;Modem/TXAudioLevel&lt;/tt&gt;.</string>
    </property>
   </widget>
   <widget class="QLabel" name="RXAudioLabel">
