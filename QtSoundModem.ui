    </property>
    <property name="value">
     <number>0</number>
    </property>
    <property name="toolTip">
     <string>Global RX offset (Hz, ±200) — manually shift all four channels' tuning by the same amount.</string>
    </property>
    <property name="whatsThis">
     <string>&lt;b&gt;Global RX offset (Hz)&lt;/b&gt;&lt;br/&gt;Adds a manual offset, applied to every channel, to the receive frequency. Use this to compensate for an off-frequency radio or a known band shift without touching each channel's centre. Range −200 to +200 Hz; default 0. Unlike the per-channel RX offset fields, this spin box is purely manual — the modem never moves it on its own.&lt;br/&gt;Stored as &lt;tt&gt;Modem/rxOffset&lt;/tt&gt;.</string>
    </property>
   </widget>
