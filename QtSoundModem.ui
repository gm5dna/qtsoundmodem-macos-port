   <widget class="QSlider" name="DCDSlider">
    <property name="geometry">
     <rect>
      <x>690</x>
      <y>18</y>
      <width>73</width>
      <height>14</height>
     </rect>
    </property>
    <property name="orientation">
     <enum>Qt::Horizontal</enum>
    </property>
    <property name="tickPosition">
     <enum>QSlider::NoTicks</enum>
    </property>
    <property name="tickInterval">
     <number>10</number>
    </property>
    <property name="toolTip">
     <string>DCD threshold — sensitivity of the busy-channel detector (the red squares above each modem).</string>
    </property>
    <property name="whatsThis">
     <string>&lt;b&gt;DCD threshold (Data Carrier Detect)&lt;/b&gt;&lt;br/&gt;Controls the sensitivity of the BusyDetect3 algorithm that lights the per-channel DCD squares red when a signal is present. Lower values trigger DCD on weaker signals (more false alarms); higher values require a stronger signal (may miss weak stations). Applied globally across all four channels. The response is non-linear — small changes near the bottom of the slider have far more effect than near the top.&lt;br/&gt;Stored as &lt;tt&gt;Modem/DCDThreshold&lt;/tt&gt;.</string>
    </property>
   </widget>
   <widget class="QTextEdit" name="monWindow">
    <property name="geometry">
     <rect>
      <x>-6</x>
      <y>60</y>
      <width>971</width>
      <height>201</height>
     </rect>
    </property>
    <property name="readOnly">
     <bool>true</bool>
    </property>
    <property name="toolTip">
     <string>Monitor: shows AX.25 frames received and transmitted as the modem decodes them.</string>
    </property>
    <property name="whatsThis">
     <string>&lt;b&gt;Monitor pane&lt;/b&gt;&lt;br/&gt;Live log of every AX.25 frame the modem decodes (RX) or sends (TX), with callsigns, paths, control field, and payload. Useful for confirming the modem is locking onto signals correctly and for sanity-checking outgoing traffic. Read-only; copy lines with the standard text-selection shortcuts.</string>
    </property>
   </widget>
