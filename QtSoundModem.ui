    <property name="frameShadow">
     <enum>QFrame::Plain</enum>
    </property>
    <property name="text">
     <string>Waterfall</string>
    </property>
    <property name="toolTip">
     <string>Waterfall: scrolling spectrogram of the receive audio (frequency on the X axis, time scrolling down).</string>
    </property>
    <property name="whatsThis">
     <string>&lt;b&gt;Waterfall display&lt;/b&gt;&lt;br/&gt;Live spectrogram of the audio being demodulated — frequency runs left-to-right, time scrolls top-to-bottom, and brightness shows signal energy. Coloured tick marks above the waterfall indicate each modem's mark/space and centre-frequency window. Use it to see whether incoming signals fall inside the modem passbands and to spot QRM. Visibility toggled from View → First/Second Waterfall; frequency range bounded by the Waterfall Min/Max settings in Settings → Setup Devices.</string>
    </property>
   </widget>
