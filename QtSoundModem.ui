   <widget class="QLabel" name="RXLevel">
    <property name="geometry">
     <rect>
      <x>780</x>
      <y>14</y>
      <width>150</width>
      <height>11</height>
     </rect>
    </property>
    <property name="frameShape">
     <enum>QFrame::Box</enum>
    </property>
    <property name="frameShadow">
     <enum>QFrame::Sunken</enum>
    </property>
    <property name="text">
     <string/>
    </property>
    <property name="toolTip">
     <string>Receive level meter — left channel of the sound card. Aim for the green band; yellow means too low to demodulate reliably; red means clipping.</string>
    </property>
    <property name="whatsThis">
     <string>&lt;b&gt;RX level meter (left channel)&lt;/b&gt;&lt;br/&gt;Shows the audio amplitude arriving from the sound card's left input. Adjust the sound card recording level (or the &quot;RX Audio&quot; slider) so the bar stays in the green region. Yellow means the level is too low to demodulate reliably (a common macOS default); red indicates clipping that will distort the signal and break demodulation.</string>
    </property>
   </widget>
