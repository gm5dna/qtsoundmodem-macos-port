       <widget class="QComboBox" name="IL2PModeA">
        <property name="geometry">
         <rect>
          <x>100</x>
          <y>280</y>
          <width>130</width>
          <height>22</height>
         </rect>
        </property>
        <item>
         <property name="text">
          <string>None</string>
         </property>
        </item>
        <item>
         <property name="text">
