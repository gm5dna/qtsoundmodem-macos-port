         </property>
        </item>
        <item>
         <property name="text">
          <string>Single</string>
         </property>
        </item>
        <property name="toolTip">
         <string>Bit recovery — when the dual-emphasis demods disagree at a bit position, the modem flips that bit and re-checks the AX.25 CRC. None = strict (no recovery); Single = try one bit-flip per frame.</string>
        </property>
       </widget>
