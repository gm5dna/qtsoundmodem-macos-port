          <width>41</width>
          <height>23</height>
         </rect>
        </property>
        <property name="toolTip">
         <string>Maximum unacknowledged AX.25 I-frames in flight (1–7). Lower = more reliable on noisy links; higher = better throughput on clean links.</string>
        </property>
