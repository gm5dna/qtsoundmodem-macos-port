          <y>308</y>
          <width>129</width>
          <height>17</height>
         </rect>
        </property>
        <property name="text">
         <string>Check CRC</string>
        </property>
        <property name="toolTip">
         <string>Reject incoming IL2P frames whose QtSM-specific CRC extension fails the check. Affects IL2P only; the standard AX.25 FCS is always checked.</string>
        </property>
       </widget>
       <widget class="QCheckBox" name="CRCTX_B">
        <property name="geometry">
         <rect>
          <x>24</x>
          <y>308</y>
          <width>97</width>
          <height>17</height>
         </rect>
        </property>
        <property name="text">
         <string>Send CRC</string>
        </property>
        <property name="toolTip">
         <string>Append a 4-byte QtSM-specific CRC extension to outgoing IL2P frames. Standalone IL2P decoders may treat the bytes as payload — only enable against receivers known to support it. The standard AX.25 FCS is always sent.</string>
        </property>
       </widget>
