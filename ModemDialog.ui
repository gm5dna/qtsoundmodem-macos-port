       <widget class="QLineEdit" name="TXDelayA">
        <property name="geometry">
         <rect>
          <x>100</x>
          <y>21</y>
          <width>41</width>
          <height>23</height>
         </rect>
        </property>
        <property name="toolTip">
         <string>TX delay (ms) — quiet pause between PTT keying and the first frame bit, so the radio's transmitter can come up to power.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;b&gt;Channel A TX delay (ms)&lt;/b&gt;&lt;br/&gt;Time the modem waits between asserting PTT and starting to send data. Must be at least as long as the radio's TX rise time, plus any squelch-tail on the receiving end. Typical: 150–300 ms for VHF FM (default 250), 300–500 ms for HF SSB or radios with slow PTT. Stored as &lt;tt&gt;Modem/TxDelay1&lt;/tt&gt;.</string>
        </property>
       </widget>
       <widget class="QLineEdit" name="TXTailA">
        <property name="geometry">
         <rect>
          <x>100</x>
          <y>50</y>
          <width>41</width>
          <height>23</height>
         </rect>
        </property>
        <property name="toolTip">
         <string>TX tail (ms) — silence after the last bit before PTT drops. Helps the receiving station's squelch close cleanly.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;b&gt;Channel A TX tail (ms)&lt;/b&gt;&lt;br/&gt;Time the modem keeps PTT keyed after the last data bit. Allows the receiver's squelch tail and the radio's PA to settle. Typically 50–150 ms. Stored as &lt;tt&gt;Modem/TxTail1&lt;/tt&gt;.</string>
        </property>
       </widget>
       <widget class="QLineEdit" name="AddRXA">
        <property name="geometry">
         <rect>
          <x>100</x>
          <y>151</y>
          <width>61</width>
          <height>23</height>
         </rect>
        </property>
        <property name="toolTip">
         <string>Number of additional RX demod pairs (extra receivers offset around the centre frequency, for catching slightly off-tuned signals).</string>
        </property>
       </widget>
       <widget class="QComboBox" name="recoverBitA">
        <property name="geometry">
         <rect>
          <x>100</x>
          <y>221</y>
          <width>130</width>
          <height>22</height>
         </rect>
        </property>
        <item>
