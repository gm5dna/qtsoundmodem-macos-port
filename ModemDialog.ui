       <widget class="QComboBox" name="fx25ModeA">
        <property name="geometry">
         <rect>
          <x>100</x>
          <y>251</y>
          <width>130</width>
          <height>22</height>
         </rect>
        </property>
        <item>
         <property name="text">
          <string>None</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>RX Only</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>RX+TX</string>
         </property>
        </item>
        <property name="toolTip">
         <string>FX.25 mode — Reed-Solomon FEC wrapper. None / RX only / RX+TX. RX-only is safe to leave on; TX requires a peer that understands FX.25.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;b&gt;Channel A FX.25 mode&lt;/b&gt;&lt;br/&gt;FX.25 wraps standard AX.25 frames in a Reed-Solomon FEC block, so a peer without FX.25 still decodes them as plain AX.25. None disables decode/encode; RX only decodes incoming FX.25; RX+TX also encodes outgoing frames. Default: RX only. Stored as &lt;tt&gt;[AX25_A]/FX25&lt;/tt&gt;.</string>
        </property>
       </widget>
